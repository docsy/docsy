{
  "name": "@docsy/theme",
  "version": "0.17.1-dev",
  "description": "A Hugo theme for technical documentation sites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docsy/docsy.git",
    "directory": "theme"
  },
  "homepage": "https://www.docsy.dev",
  "bugs": "https://github.com/docsy/docsy/issues",
  "license": "Apache-2.0",
  "keywords": [
    "hugo",
    "hugo-theme",
    "documentation",
    "technical-documentation",
    "docsy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gen-favicons": "scripts/gen-favicons/cli.mjs"
  },
  "files": [
    "assets",
    "hugo.yaml",
    "i18n",
    "layouts",
    "scripts/gen-favicons/cli.mjs",
    "scripts/gen-favicons/index.mjs",
    "scripts/gen-favicons/README.md",
    "static"
  ],
  "scripts": {
    "prepack": "node ../scripts/pack-stamp.mjs pre && node -e \"require('fs').copyFileSync('../LICENSE', 'LICENSE')\"",
    "postpack": "node -e \"require('fs').rmSync('LICENSE', { force: true })\" && node ../scripts/pack-stamp.mjs post",
    "update:packages": "npm-check-updates -u -x @fortawesome/fontawesome-free,bootstrap"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "bootstrap": "5.3.8"
  }
}
